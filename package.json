{
  "name": "home-kiosk",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --mode standalone",
    "package:app": "npm run build:app && python3 scripts/package_app.py",
    "deploy": "bash scripts/deploy.sh",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/data/*.test.ts server/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
