{
  "name": "Home Kiosk",
  "version": "0.2.0",
  "slug": "home_kiosk",
  "description": "Local home dashboard with selectable HA doorbell and built-in kiosk display",
  "url": "https://github.com/korellas/home-kiosk",
  "image": "ghcr.io/korellas/home-kiosk",
  "arch": [
    "aarch64"
  ],
  "stage": "experimental",
  "init": false,
  "timeout": 15,
  "ingress": true,
  "panel_title": "우리 집",
  "panel_icon": "mdi:home-automation",
  "homeassistant_api": true,
  "udev": true,
  "devices": [
    "/dev/dri/card0",
    "/dev/dri/card1",
    "/dev/dri/card2",
    "/dev/dri/card3",
    "/dev/dri/renderD128",
    "/dev/dri/renderD129",
    "/dev/input/event0",
    "/dev/input/event1",
    "/dev/input/event2",
    "/dev/input/event3",
    "/dev/input/event4",
    "/dev/input/event5",
    "/dev/input/event6",
    "/dev/input/event7",
    "/dev/input/event8",
    "/dev/input/event9",
    "/dev/input/event10",
    "/dev/input/event11",
    "/dev/input/event12",
    "/dev/input/event13",
    "/dev/input/event14",
    "/dev/input/event15",
    "/dev/input/event16",
    "/dev/input/event17",
    "/dev/input/event18",
    "/dev/input/event19",
    "/dev/input/event20",
    "/dev/input/event21",
    "/dev/input/event22",
    "/dev/input/event23",
    "/dev/input/event24",
    "/dev/input/event25",
    "/dev/input/event26",
    "/dev/input/event27",
    "/dev/input/event28",
    "/dev/input/event29",
    "/dev/input/event30",
    "/dev/input/event31"
  ],
  "backup_exclude": [
    "chromium/*/Cache",
    "chromium/*/Code Cache",
    "chromium/*/GPUCache"
  ],
  "options": {
    "kiosk": true,
    "rotation": "normal",
    "debug": false
  },
  "schema": {
    "kiosk": "bool",
    "rotation": "list(normal|90|180|270)",
    "debug": "bool"
  },
  "audio": true
}
